{
  "name": "digital-expense-tracker-root",
  "version": "1.0.0",
  "description": "Production MERN Stack Digital Expense Tracker",
  "private": true,
  "scripts": {
    "server": "python server/app.py",
    "server:python": "python server/app.py",
    "server:node": "npm --prefix server run dev:node",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "python server/seed.py",
    "seed:python": "python server/seed.py",
    "seed:node": "npm --prefix server run seed:node",
    "demo:ca2": "python server/ca2_pymongo_demo.py",
    "test": "python server/test_pymongo_api.py",
    "dev": "concurrently -n \"PYMONGO,CLIENT\" -c \"yellow,cyan\" \"python server/app.py\" \"npm --prefix client run dev\"",
    "dev:node": "concurrently -n \"NODE,CLIENT\" -c \"blue,cyan\" \"npm --prefix server run dev:node\" \"npm --prefix client run dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
